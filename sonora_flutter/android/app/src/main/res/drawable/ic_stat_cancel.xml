<?xml version="1.0" encoding="utf-8"?>
<!--
  Android renders notification action icons from their alpha mask and ignores
  color, so this is a plain stroked cross. It is sized and padded like
  ic_stat_sonora so the two read as the same family of glyphs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M7,7 L17,17"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
    <path
        android:pathData="M17,7 L7,17"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />
</vector>